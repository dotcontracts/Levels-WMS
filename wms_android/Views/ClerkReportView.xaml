<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:wms_android.Controls"
             xmlns:viewmodels="clr-namespace:wms_android.ViewModels"
             xmlns:dto="clr-namespace:wms_android.shared.DTOs;assembly=wms_android.shared"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:DataType="viewmodels:ClerkReportViewModel"
             x:Class="wms_android.Views.ClerkReportView"
             BackgroundColor="{StaticResource Background}"
             Title="My Report">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Date Picker -->
                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="10" Padding="15">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="&#xf073;" FontFamily="FASolid" FontSize="18"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Report Date" FontSize="11" TextColor="#888"/>
                            <DatePicker Date="{Binding SelectedDate}"
                                        Format="dd MMM yyyy"
                                        FontSize="15"
                                        TextColor="{StaticResource PrimaryDark}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Activity Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"/>

                <!-- Daily Summary -->
                <Label Text="Daily Summary" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}"
                       IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <Frame Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                           BorderColor="Transparent" CornerRadius="10" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="Parcels Raised" TextColor="White" FontSize="12"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding DailyParcelCount}" TextColor="White"
                                   FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" BackgroundColor="{StaticResource PrimaryDark}"
                           BorderColor="Transparent" CornerRadius="10" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="Daily Sales" TextColor="White" FontSize="12"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding DailySalesTotal, StringFormat='Ksh {0:N0}'}"
                                   TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Monthly Ranking -->
                <Label Text="Monthly Performance" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}"
                       IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <Frame Grid.Column="0" BackgroundColor="#7B1FA2"
                           BorderColor="Transparent" CornerRadius="10" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="Monthly Sales" TextColor="White" FontSize="12"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding MonthlyTotal, StringFormat='Ksh {0:N0}'}"
                                   TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" BackgroundColor="#F57F17"
                           BorderColor="Transparent" CornerRadius="10" Padding="15">
                        <VerticalStackLayout>
                            <Label Text="&#xf091;" FontFamily="FASolid" FontSize="20"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Ranking" TextColor="White" FontSize="12"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding RankingLabel}" TextColor="White"
                                   FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Deposits Section -->
                <Label Text="Deposits" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}"
                       IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="10" Padding="12"
                       IsVisible="{Binding HasDeposits, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="No deposits recorded for this date."
                           TextColor="#888" FontSize="13" HorizontalOptions="Center"/>
                </Frame>

                <CollectionView ItemsSource="{Binding Deposits}"
                                IsVisible="{Binding HasDeposits}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ClerkReportExpenseItem">
                            <Frame BackgroundColor="White" BorderColor="#E0E0E0"
                                   CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="&#xf4d3;" FontFamily="FASolid"
                                           FontSize="16" TextColor="#388E3C" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Description}" FontSize="13"
                                               TextColor="#333" FontAttributes="Bold"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                               FontSize="11" TextColor="#888"/>
                                        <Label Text="{Binding RejectionReason}"
                                               FontSize="11" TextColor="#E53935"
                                               IsVisible="{Binding RejectionReason, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='Ksh {0:N0}'}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" HorizontalOptions="End"/>
                                        <Label Text="{Binding Status}" FontSize="11"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="approved">
                                                    <Setter Property="TextColor" Value="#388E3C"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="TextColor" Value="#F57F17"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="rejected">
                                                    <Setter Property="TextColor" Value="#E53935"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Expenses Section -->
                <Label Text="Expenses" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}"
                       IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="10" Padding="12"
                       IsVisible="{Binding HasExpenses, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="No expenses recorded for this date."
                           TextColor="#888" FontSize="13" HorizontalOptions="Center"/>
                </Frame>

                <CollectionView ItemsSource="{Binding Expenses}"
                                IsVisible="{Binding HasExpenses}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ClerkReportExpenseItem">
                            <Frame BackgroundColor="White" BorderColor="#E0E0E0"
                                   CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="&#xf543;" FontFamily="FASolid"
                                           FontSize="16" TextColor="#1565C0" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Description}" FontSize="13"
                                               TextColor="#333" FontAttributes="Bold"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                               FontSize="11" TextColor="#888"/>
                                        <Label Text="{Binding RejectionReason}"
                                               FontSize="11" TextColor="#E53935"
                                               IsVisible="{Binding RejectionReason, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='Ksh {0:N0}'}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" HorizontalOptions="End"/>
                                        <Label Text="{Binding Status}" FontSize="11"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="approved">
                                                    <Setter Property="TextColor" Value="#388E3C"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="TextColor" Value="#F57F17"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="rejected">
                                                    <Setter Property="TextColor" Value="#E53935"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingOverlay />
    </Grid>
</ContentPage>
